{
  "name": "@local/dsh-session-search",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "维护模式的历史会话字面量检索工具；DSH 0.2.1+ 建议优先使用官方 Session search。",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "meta": {
    "title": "历史会话检索",
    "description": "为模型提供 search_past_sessions 工具，可按字面量检索本机历史会话并返回带上下文的片段。"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.15"
  }
}
