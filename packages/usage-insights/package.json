{
  "name": "@local/dsh-usage-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "跨会话用量与成本面板：把 DSH 桌面版所有会话的 token、缓存命中率、耗时与估算成本折叠成一页。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "meta": {
    "title": "会话用量与成本",
    "description": "跨会话汇总 token、缓存命中率、耗时与估算成本。"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.15"
  }
}
